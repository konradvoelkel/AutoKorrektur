<?xml version="1.0" encoding="utf-8"?>
<!-- Body of the Diagnostics dialog (ui/diagnostics/DiagnosticsDialog.kt): the opt-in switch, a
     plain-language description of what is and isn't recorded, the current store summary, and a
     plain-words list of the recorded events.

     The list exists because of usability run 002 (UX-12): the dialog used to show only a count
     and a size, so the only way to find out what had been recorded was to export a `.jsonl` and
     open it in another app — which is exactly what the privacy-conscious non-developer the
     feature is for cannot do.

     The root is a ScrollView on purpose. With the description spelling out every recorded field
     (UX-16) plus the event list, the body is taller than a 720x1280 screen, and a non-scrolling
     body pushed the dialog's own Delete button off the bottom — found on the emulator while
     fixing UX-11, which made Delete unreachable on exactly the small screen the run used. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/diagnostics_switch"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@+id/tvDiagnosticsDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/diagnostics_description"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <!-- Long-press copies the installation ID, which is shown in full: it is a random UUID,
             so there is nothing to protect by shortening it, and a field tester needs to be able
             to quote it in a bug report (UX-21). -->
        <TextView
            android:id="@+id/tvDiagnosticsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="12 events · 3.4 KB\nID 0000-0000" />

        <!-- Delete lives in the body, not in the dialog's button row: three buttons stack on a
             narrow phone and pushed this one off the bottom of a 720x1280 screen, and a
             destructive action should not sit shoulder to shoulder with Cancel anyway. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiagnosticsDelete"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="-8dp"
            android:text="@string/diagnostics_delete"
            android:textColor="@color/feedback_negative" />

        <TextView
            android:id="@+id/tvDiagnosticsEventsHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/diagnostics_events_heading"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <TextView
            android:id="@+id/tvDiagnosticsEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            tools:text="Sep 28, 13:58 — App started, version 2.0.0\nSep 28, 13:59 — Photo processed: 1 vehicle found, 1.7 s" />
    </LinearLayout>
</ScrollView>
