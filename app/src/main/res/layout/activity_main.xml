<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />

    </com.google.android.material.appbar.AppBarLayout>

    <include layout="@layout/content_main" />

    <!-- Hosts the app's global dialogs (About, Diagnostics) in Compose while the rest of the
         screen is still Views. Zero-sized on purpose: a Compose `AlertDialog` opens in its own
         window, so this view only needs to exist in the hierarchy, not to occupy it. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/dialogHost"
        android:layout_width="0dp"
        android:layout_height="0dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
